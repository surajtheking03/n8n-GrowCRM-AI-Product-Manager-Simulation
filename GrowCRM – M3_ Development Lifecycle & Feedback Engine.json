    {
      "parameters": {
        "jsCode": "const body = items[0].json.body || items[0].json || {};\n\nconst jira_key = body.jira_key || \"\";\nconst feedback_status = body.feedback_status || \"\";\nconst feedback_notes = body.feedback_notes || \"\";\nconst client_name = body.client_name || \"\";\n\nconst transitionMap = {\n  \"selected_for_development\": 21,\n  \"in_development\": 51,\n  \"testing\": 61,\n  \"client_review\": 71,\n  \"delivered\": 81,\n  \"done\": 41\n};\n\nconst transitionId = transitionMap[feedback_status];\n\nif (!transitionId) {\n  throw new Error(\"Invalid feedback_status: \" + feedback_status);\n}\n\nreturn [{ json: { jira_key, feedback_status, feedback_notes, transitionId, client_name } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [624,144],
      "id": "0d93293b-3327-478d-bc12-64367a0b023a",
      "name": "Code in JavaScript"
    },

    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "=={{ $json.body.jira_key || $json.jira_key }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            },
            {
              "leftValue": "=={{ $json.body.feedback_status || $json.feedback_status }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEmpty" }
            }
          ],
          "combinator": "and"
        }
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [288,160],
      "id": "9b97e1c2-545c-457c-90ef-a31081740e76",
      "name": "If1"
    },

    {
