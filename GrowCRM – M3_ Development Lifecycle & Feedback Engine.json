        "url": "=https://YOUR_JIRA_DOMAIN/rest/api/3/issue/{{$json.jira_key}}/transitions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "jiraSoftwareCloudApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"transition\":{\"id\": {{$json.transitionId}}}}"
      },
